# Optional. If set, every request must include header:
# X-API-Key: your_backend_key
# Required when exposing the backend through Cloudflare Tunnel.
BACKEND_API_KEY=

# Optional. Forces /action-schema.yaml to advertise this HTTPS API origin.
# If omitted, the backend uses the request Host header.
ACTION_SCHEMA_PUBLIC_URL=

# Comma-separated frontend/GPT origins allowed by CORS.
# Include ChatGPT origins so GPT Action preflight requests do not fail before routing.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://chat.openai.com,https://chatgpt.com,https://www.chatgpt.com

# OpenDART API key
OPENDART_API_KEY=

# Optional future integrations
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
KIS_IS_PAPER=true
KIS_TOKEN_CACHE_PATH=data/kis_token_cache.json
KIS_TOKEN_ISSUE_COOLDOWN_SECONDS=70
KIS_REQUEST_MIN_INTERVAL_SECONDS=1.5

# Optional daily market-context JSON feed.
# It should return KOSPI/KOSDAQ, USD/KRW, VIX, rates, and sector ETF/index series.
MARKET_CONTEXT_URL=
MARKET_CONTEXT_TIMEOUT=10

# Live trading is intentionally disabled by default.
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRM_TOKEN=

# Trading cost assumptions. Tune these to your broker/account.
COMMISSION_RATE=0.00015
KR_STOCK_SELL_TAX_RATE=0.002
US_FX_SPREAD_BPS=5
DEFAULT_FILL_PROBABILITY=0.95
MIN_FILL_PROBABILITY=0.7
MARGIN_INTEREST_ANNUAL_RATE=0.08
SHORT_BORROW_ANNUAL_RATE=0.03
PERFORMANCE_MIN_TRADE_COUNT=10
EMERGENCY_STOP=false
EMERGENCY_STOP_FILE=data/EMERGENCY_STOP
MAX_ORDER_API_RETRIES=1
MAX_ORDER_PRICE_DEVIATION_BPS=300

# Persistent auto-trading worker/session settings.
AUTO_TRADING_DB_PATH=data/auto_trading.sqlite3
AUTO_TRADING_WORKER_POLL_SECONDS=2
AUTO_TRADING_WORKER_LOCK_SECONDS=60
AUTO_TRADING_SYMBOL_WORKERS=1
AUTO_TRADING_MAX_OPEN_POSITIONS=12
AUTO_TRADING_ONE_SESSION_PER_ACCOUNT=true
TRADE_ORCHESTRATOR_ENABLED=true
TRADE_ORCHESTRATOR_INTERVAL_SECONDS=60
TRADE_ORCHESTRATOR_EXECUTE_ENTRIES=true
TRADE_ORCHESTRATOR_BASE_POSITION_WEIGHT=0.10
TRADE_ORCHESTRATOR_MIN_POSITION_WEIGHT=0.05
TRADE_ORCHESTRATOR_MAX_POSITION_WEIGHT=0.30
TRADE_ORCHESTRATOR_EDGE_WEIGHT_CAP_BPS=300
POSITION_TIME_STOP_TRADING_DAYS=3
STRATEGY_CIRCUIT_BREAKER_ENABLED=true
STRATEGY_CIRCUIT_BREAKER_WIN_RATE_FLOOR=0.200
STRATEGY_CIRCUIT_BREAKER_MIN_TRADES=10
STRATEGY_CIRCUIT_BREAKER_LOOKBACK_TRADES=10
STRATEGY_CIRCUIT_BREAKER_SCALE=0.6
ENTRY_TIME_FILTER_ENABLED=true
ENTRY_TIME_WINDOWS=09:00-10:30,14:30-15:20
LIVE_EXIT_CONFIRM_BEFORE_ENTRY=true
EDGE_CALIBRATION_ENABLED=true
EDGE_CALIBRATION_DB_PATH=data/edge_calibration.sqlite3
EDGE_CALIBRATION_INTERVAL_SECONDS=3600
EDGE_CALIBRATION_HORIZON_SECONDS=86400
EDGE_CALIBRATION_MAX_SAMPLES=5000
EDGE_CALIBRATION_MIN_SAMPLES=30
EDGE_CALIBRATION_FUTURE_PRICE_LIMIT=96
EDGE_CALIBRATION_RIDGE_LAMBDA=10
EDGE_CALIBRATION_BLEND=0.35
EDGE_CALIBRATION_TARGET_SAMPLES=3000
EDGE_CALIBRATION_SAMPLE_RETENTION_LIMIT=10000
EDGE_CALIBRATION_GATE_MIN_SAMPLES=600
EDGE_CALIBRATION_GATE_MIN_OOS_SAMPLES=50
EDGE_CALIBRATION_GATE_MAX_MAE_RETURN_BPS=180
EDGE_CALIBRATION_GATE_MAX_MAE_RISK_BPS=180
EDGE_CALIBRATION_GATE_MIN_TOP10_AVG_RETURN_BPS=10
EDGE_CALIBRATION_GATE_MIN_TOP10_WIN_RATE=0.40
EDGE_CALIBRATION_GATE_MIN_TOP10_EXPECTANCY_BPS=0
EDGE_CALIBRATION_GATE_MIN_FILL_ADJUSTED_EDGE_BPS=10
BROKER_SYNC_DB_PATH=data/broker_sync.sqlite3
ORDER_STATE_DB_PATH=data/order_state.sqlite3
ORDER_DEDUPE_WINDOW_SECONDS=120
ALLOW_POSITION_ADDITIONS=false
DYNAMIC_RISK_LIMITS_ENABLED=true
DYNAMIC_RISK_MIN_MULTIPLIER=0.35
DYNAMIC_RISK_MAX_MULTIPLIER=1.25
DYNAMIC_RISK_HIGH_ATR_PCT=0.10
DYNAMIC_RISK_LOW_ATR_PCT=0.025
DYNAMIC_RISK_HIGH_CORRELATION=0.75
DYNAMIC_RISK_BEAR_MULTIPLIER=0.6
DYNAMIC_RISK_BULL_MULTIPLIER=1.05
DYNAMIC_RISK_UNKNOWN_MULTIPLIER=1.0

# Periodic market monitor jobs. The auto-trading worker runs these by default.
MARKET_MONITOR_ENABLED=true
MARKET_MONITOR_DB_PATH=data/market_monitor.sqlite3
MONITOR_WATCHLIST_SYMBOLS=005930,000660,035420,035720,247540,086520
MONITOR_MARKET_KEYWORDS=코스피,코스닥,환율,금리,미국증시,나스닥,반도체,AI,2차전지,로봇,바이오
MONITOR_PRICE_INTERVAL_SECONDS=60
MONITOR_DISCLOSURE_INTERVAL_SECONDS=300
MONITOR_NEWS_INTERVAL_SECONDS=600
MONITOR_SURGE_CHANGE_PCT=5
MONITOR_DROP_CHANGE_PCT=-5
MONITOR_VOLUME_SPIKE_RATIO=2.5
MONITOR_DEFAULT_STOP_LOSS_PCT=2
MONITOR_DEFAULT_TAKE_PROFIT_PCT=4
MONITOR_NEWS_DISPLAY=20
BROKER_SYNC_INTERVAL_SECONDS=60
BROKER_SYNC_CONFIG_ERROR_BACKOFF_SECONDS=900

# Optional real-time alert webhook. If empty, alerts are stored in SQLite only.
ALERT_DB_PATH=data/alerts.sqlite3
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT=5
ALERT_MIN_SEVERITY=high
ALERT_MIN_IMPACT_STRENGTH=70

# Universe scanner for "start only" auto-trading.
UNIVERSE_SCANNER_DB_PATH=data/universe_scanner.sqlite3
UNIVERSE_SCANNER_SEED_SYMBOLS=
UNIVERSE_SCANNER_CANDIDATE_LIMIT=50
UNIVERSE_SCANNER_FINAL_LIMIT=10
UNIVERSE_SCANNER_MAX_SOURCE_SYMBOLS=50
UNIVERSE_SCANNER_SYMBOL_INTERVAL_SECONDS=60
UNIVERSE_SCANNER_MIN_SCANNED_SYMBOLS_FOR_TRADING=20
UNIVERSE_SCANNER_CANDIDATE_TTL_SECONDS=1800
UNIVERSE_SCANNER_WORKER_HURDLE_RATE_BPS=25
UNIVERSE_SCANNER_DEFAULT_SPREAD_BPS=5
UNIVERSE_SCANNER_DEFAULT_SLIPPAGE_BPS=10
UNIVERSE_SCANNER_MIN_TURNOVER_VALUE=5000000000
UNIVERSE_SCANNER_MIN_VOLUME=200000
UNIVERSE_SCANNER_MACRO_MIN_RISK_ON_SCORE=35
UNIVERSE_SCANNER_MIN_MARKET_CAP=200000000000
UNIVERSE_SCANNER_MAX_MARKET_CAP=10000000000000
UNIVERSE_SCANNER_LARGE_CAP_MIN_3D_RETURN_BPS=150

# Render single-service mode. Keep false locally unless you want the API process
# to start embedded worker threads automatically.
EMBEDDED_WORKERS_ENABLED=false
EMBEDDED_WORKER_BROKER_SYNC_ENABLED=true

# Optional, used only when manually running tests/test_kis_paper_e2e.py.
RUN_KIS_PAPER_E2E=0
KIS_E2E_SYMBOL=005930
KIS_E2E_SIDE=buy
KIS_E2E_QUANTITY=1
KIS_E2E_REQUIRE_FILL=0
